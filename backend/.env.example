DEEPSEEK_API_KEY=
# Agent V1 uses the existing DeepSeek key unless AGENT_API_KEY is set.
AGENT_MODEL=deepseek-chat
AGENT_BASE_URL=https://api.deepseek.com
AGENT_REQUEST_TIMEOUT=40
AGENT_TOOL_TIMEOUT=60
AGENT_TOTAL_TIMEOUT=150
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional local model overrides
MINILM_MODEL_PATH=
BGE_M3_MODEL_PATH=

# Optional Alibaba Cloud paper parsing
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# Optional figure/vision analysis
VISION_API_BASE=
VISION_API_KEY=
VISION_MODEL=
